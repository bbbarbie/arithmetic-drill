# Backend port for the small Express API (the Vite dev server proxies /api here).
PORT=8787

# LLM backend for the Answer Checker's non-arithmetic path (probability, expected
# value, free-form questions). Options: "anthropic" | "none". Default: none.
LLM_PROVIDER=none

# Only used when LLM_PROVIDER=anthropic. Never exposed to the browser.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
